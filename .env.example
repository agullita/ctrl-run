# ---------------------------------------------------------------------------
# CTRL+RUN // VARIABLES DE ENTORNO
# Copia este archivo a `.env.local` y completa los valores.
# Todo lo prefijado con VITE_ queda expuesto en el bundle del navegador.
# ---------------------------------------------------------------------------

# --- Supabase (opcional) ---------------------------------------------------
# Sin estas variables la app corre 100% en DEMO MODE:
# stream mock local + persistencia en sessionStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Strava (cliente) ------------------------------------------------------
# Client ID público. El CLIENT SECRET nunca vive en el frontend.
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/auth/strava
# true = no redirige a Strava: simula el handshake OAuth2.
# Ponlo en false recién cuando la Edge Function esté desplegada.
VITE_STRAVA_DEMO_MODE=true

# --- Supabase Edge Function secrets (servidor) -----------------------------
# Se configuran con:
#   supabase secrets set STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=...
# NO los pongas con prefijo VITE_.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/auth/strava
