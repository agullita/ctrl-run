# ---------------------------------------------------------------------------
# CTRL+RUN // VARIABLES DE ENTORNO
# Copia este archivo a `.env.local` y completa los valores.
# Todo lo prefijado con VITE_ queda expuesto en el bundle del navegador.
# ---------------------------------------------------------------------------

# --- Supabase (cliente) -----------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Suunto OAuth2 (cliente) -----------------------------------------------
# Client ID público. El Client Secret vive solo en la Edge Function.
VITE_SUUNTO_CLIENT_ID=
VITE_SUUNTO_REDIRECT_URI=http://localhost:5173/auth/suunto/callback
# true = no redirige a Suunto; usa el stream demo local.
VITE_SUUNTO_DEMO_MODE=true
# Opcional. Por defecto se usa el endpoint oficial.
VITE_SUUNTO_AUTH_URL=https://cloudapi-oauth.suunto.com/oauth/authorize

# --- Supabase Edge Function secrets (servidor) -----------------------------
# supabase secrets set SUUNTO_CLIENT_ID=... SUUNTO_CLIENT_SECRET=... SUUNTO_REDIRECT_URI=... SUUNTO_SUBSCRIPTION_KEY=...
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_REDIRECT_URI=http://localhost:5173/auth/suunto/callback
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_API_BASE=https://cloudapi.suunto.com
